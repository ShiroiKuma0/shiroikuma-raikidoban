<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android" 
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingLeft="5dp"
    android:paddingRight="5dp"
    android:orientation="vertical">
		
	<!-- Recently-picked colours: one-tap round swatches, populated at runtime (hidden when empty). -->
	<LinearLayout
		android:id="@+id/recent_colors"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_horizontal"
		android:orientation="horizontal"
		android:paddingTop="6dp"
		android:paddingBottom="4dp"
		android:visibility="gone" />

	<!-- Fixed size (instead of match_parent + weight) so the picker doesn't balloon on wide screens. -->
	<net.margaritov.preference.colorpicker.ColorPickerView
		android:id="@+id/color_picker_view"
		android:layout_width="280dp"
		android:layout_height="240dp"
		android:layout_gravity="center_horizontal"
		android:tag="portrait"
		android:layerType="software"
	/>

	<FrameLayout
	    android:layout_width="match_parent"
	    android:layout_height="wrap_content"
	    android:padding="7dip">
		<EditText
		    android:id="@+id/hex_editor"
		    android:layout_width="wrap_content"
		    android:layout_height="match_parent"
		    android:layout_gravity="center"
		    android:gravity="center"
		    android:inputType="textNoSuggestions"
		    android:maxLength="8"
		    android:ems="10" >
		</EditText>
	</FrameLayout>

	<!-- Cancel / OK as themed push-buttons (BUTTONS slots): black bg, yellow text + border, rounded,
	     all configurable under the 「白い熊 雷起動盤 UI」 Buttons section. Each sizes to its own label on a
	     single line (so 「キャンセル」 never wraps), with a min width so OK isn't tiny. -->
	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_horizontal"
		android:orientation="horizontal"
		android:layout_margin="10dp">

		<Button
			android:id="@+id/cancel_button"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:maxLines="1"
			android:minWidth="120dp"
			android:text="@android:string/cancel" />

		<View
			android:layout_width="12dp"
			android:layout_height="match_parent" />

		<Button
			android:id="@+id/ok_button"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:maxLines="1"
			android:minWidth="120dp"
			android:text="@android:string/ok" />
	</LinearLayout>
	
</LinearLayout>