<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:right="8dp"
        android:left="8dp"
        android:top="8dp"
        android:bottom="8dp">
        <shape>
            <padding
                android:bottom="8dp"
                android:left="8dp"
                android:top="8dp"
                android:right="8dp" />
            <corners android:radius="8dp" />
            <solid android:color="?android:colorBackgroundFloating" />
            <!-- The yellow chrome border is applied at runtime (Dashboard.applyBubblePanel, MENU_BORDER)
                 so it follows the 「白い熊 雷起動盤 UI」 colour + width sliders. -->
            <!-- (default fallback only; runtime overrides this drawable) -->
        </shape>
    </item>
</layer-list>